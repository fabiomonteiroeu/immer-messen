{
  "collectionName": "components_page_about_content_blocks",
  "info": {
    "displayName": "About Content Block"
  },
  "options": {},
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "intro": {
      "type": "richtext"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "page",
        "home-about"
      ],
      "default": "page"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "cards": {
      "type": "component",
      "repeatable": true,
      "component": "page.about-card"
    },
    "rows": {
      "type": "component",
      "repeatable": true,
      "component": "page.about-row"
    },
    "highlight": {
      "type": "component",
      "repeatable": false,
      "component": "page.about-highlight"
    }
  }
}

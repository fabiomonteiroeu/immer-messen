{
  "collectionName": "components_page_callout_items",
  "info": {
    "displayName": "Callout Item"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "description": {
      "type": "text",
      "maxLength": 220
